---
import { scholar } from '../utils/scholar';

const { publication, featured = false } = Astro.props;
const scholarMatch = Object.values(scholar.publications).find((entry) =>
  entry.title && publication.title.toLowerCase().includes(entry.title.toLowerCase().slice(0, 36)),
);
const citationLabel = scholarMatch?.num_citations != null ? String(scholarMatch.num_citations) + ' citations' : null;
---
<article class:list={['publication-card', { featured }]}>
  <div class="publication-media">
    <img src={publication.image} alt={publication.title + ' figure'} loading={featured ? 'eager' : 'lazy'} />
    <span class="publication-year">{publication.year}</span>
  </div>
  <div class="publication-body">
    <div class="publication-meta">
      <span>{publication.venue}</span>
      {citationLabel && <span>· {citationLabel}</span>}
    </div>
    <h3><a href={publication.paper} target="_blank" rel="noreferrer">{publication.title} <span aria-hidden="true">↗</span></a></h3>
    <p class="publication-authors">{publication.authors.map((author) => author === 'Jia Wei' ? <strong>{author}</strong> : author).map((author, index) => <>{index > 0 && ', '}{author}</>)}</p>
    <p class="publication-highlight">{publication.highlight}</p>
    <div class="publication-actions">
      <a class="text-link" href={publication.paper} target="_blank" rel="noreferrer">Paper <span aria-hidden="true">↗</span></a>
      {publication.code && <a class="text-link" href={publication.code} target="_blank" rel="noreferrer">Code <span aria-hidden="true">↗</span></a>}
      <button class="copy-bibtex" type="button" data-bibtex={publication.bibtex}>Copy BibTeX</button>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-bibtex').forEach((button) => {
    button.addEventListener('click', async () => {
      const value = button.dataset.bibtex ?? '';
      try {
        await navigator.clipboard.writeText(value);
        button.textContent = 'Copied';
        window.setTimeout(() => { button.textContent = 'Copy BibTeX'; }, 1600);
      } catch {
        button.textContent = 'Select BibTeX';
      }
    });
  });
</script>
